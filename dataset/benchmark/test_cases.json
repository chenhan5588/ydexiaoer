{
  "version": "1.0",
  "description": "PrintOS 自动化回归测试用例。每次修改修复引擎后跑一遍。",
  "test_cases": [
    {
      "id": "TC-001",
      "name": "纯色黑底 Logo 去背景",
      "input": "v1/001/input.png",
      "expected_output": "v1/001/output.png",
      "type": "remove_background",
      "difficulty": 1,
      "pass_criteria": {
        "has_transparency": true,
        "psnr_min": 30,
        "edge_jagged_max": 5
      }
    },
    {
      "id": "TC-002",
      "name": "低分辨率放大+去背景 (1024→5906)",
      "input": "v1/002/input.png",
      "expected_output": "v1/002/output.png",
      "type": "upscale_and_remove_bg",
      "difficulty": 2,
      "pass_criteria": {
        "min_dimension": 5906,
        "has_transparency": true,
        "psnr_min": 25
      }
    },
    {
      "id": "TC-003",
      "name": "低分辨率放大+去背景 (1206→5906)",
      "input": "v1/003/input.png",
      "expected_output": "v1/003/output.png",
      "type": "upscale_and_remove_bg",
      "difficulty": 2,
      "pass_criteria": {
        "min_dimension": 5906,
        "has_transparency": true,
        "psnr_min": 25
      }
    },
    {
      "id": "TC-004",
      "name": "深色纹理背景去底 (1365→5906)",
      "input": "v1/004/input.png",
      "expected_output": "v1/004/output.png",
      "type": "remove_background",
      "difficulty": 2,
      "pass_criteria": {
        "has_transparency": true,
        "psnr_min": 25,
        "no_background_residue": true
      }
    },
    {
      "id": "TC-005",
      "name": "超大图缩小+去背景 (8000→5906)",
